# Copy this file to ".env" and fill it in. NEVER commit .env or share it.

# Full URL of the site, no trailing slash (used for OAuth redirect URLs and passkeys)
# Local XAMPP example: http://localhost/VentoTravel
APP_URL=http://localhost/VentoTravel
CONTACT_EMAIL=info@yourdomain.com

# Database
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=VentoTravel

# Google sign-in  (leave empty to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple sign-in  (leave empty to hide the button; needs HTTPS + paid Apple Developer account)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Absolute path to the downloaded .p8 key, keep it OUTSIDE the website folder
APPLE_PRIVATE_KEY_PATH=
